# SOLIVY Finance v2.7.0-rc.1 — environment example. Copy to .env.local (offline) or set in your host (online).
# Contains NO real secrets. Generate your own values; never commit the real file.

# --- Required in production -------------------------------------------------
# Long random string (>= 32 chars), e.g. `openssl rand -base64 48`. Rotating it signs everyone out.
SESSION_SECRET=
# One-time secret required by /api/setup to create the first administrator. Remove after setup.
SOLIVY_SETUP_SECRET=

# --- Online mode (PostgreSQL / Neon) ----------------------------------------
# Set to enable online mode. Leave empty for offline (local SQLite files only).
# Neon: use the pooled connection string with sslmode=require.
DATABASE_URL=
# Only for a local, loopback-only Postgres in development/testing. Ignored for any non-loopback host.
# SOLIVY_PG_SSL=disable

# --- Offline mode -----------------------------------------------------------
# Folder for SQLite files (admin.db + one file per organization per LIVE/TEST). Default: user data folder.
FINANCE_DATA_DIR=

# --- Licensing --------------------------------------------------------------
# off (default) | required. With "required", every organization needs a valid signed token.
SOLIVY_LICENSE_ENFORCEMENT=off
# Either a single token, or a JSON map {"<companyId>":"<token>","*":"<fallback>"}.
SOLIVY_LICENSE_TOKEN=
SOLIVY_LICENSES_JSON=

# --- Networking -------------------------------------------------------------
# Set to 1 only behind a trusted reverse proxy that overwrites X-Forwarded-For (used for login throttling).
TRUST_PROXY_HEADERS=0
APP_BASE_URL=

# --- Transfer budget (optional) ---------------------------------------------
# Your database provider's monthly data-transfer allowance, in GB (default 25). The administrator
# diagnostics panel measures month-to-date usage against it and raises alerts at 50/75/90/100%.
# These are application-measured figures, not the provider's bill.
SOLIVY_TRANSFER_BUDGET_GB=25

# --- Diagnostics (optional) -------------------------------------------------
# 1 logs snapshot chunk decisions to the server log. Verbose; leave unset in production.
# The admin "API & database transfer" panel needs nothing here: it reads the metrics table the
# application writes by itself.
SOLIVY_BRIDGE_DEBUG=

# --- Optional e-mail (password reset / notices) -----------------------------
RESEND_API_KEY=
MAIL_FROM=
SOLIVY_ADMIN_EMAIL=
