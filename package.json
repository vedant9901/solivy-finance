{
  "name": "solivy-finance",
  "version": "2.7.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/ensure-local-secret.cjs && next start",
    "lint": "next lint",
    "check:env": "node scripts/check-env.mjs",
    "check:import": "node scripts/check-import-schema.mjs",
    "check:source": "node scripts/check-source.cjs",
    "check:database-bridge": "node scripts/check-database-bridge.mjs",
    "check:security": "node scripts/check-security.cjs",
    "license:issue": "node scripts/license-tool.cjs issue",
    "license:keygen": "node scripts/license-tool.cjs keygen",
    "check:license": "node scripts/license-tool.cjs self-test",
    "db:upload-sqlite-snapshots": "node scripts/upload-sqlite-snapshots-to-postgres.mjs",
    "check:transfers": "node scripts/check-transfers.mjs",
    "check:sync": "node scripts/check-sync.mjs",
    "check:test-to-live": "node scripts/check-test-to-live-purge-fix.mjs",
    "check:user-org-conflicts": "node scripts/check-user-org-conflicts.cjs",
    "check:money-out": "node scripts/check-money-out.cjs",
    "check:multicompany-sync": "node scripts/check-multicompany-sync.cjs",
    "check:finance-mis": "node scripts/check-finance-mis.cjs",
    "check:funding-transfer": "node scripts/check-funding-transfer.cjs",
    "check:online-login-org": "node scripts/check-online-login-org.cjs",
    "check:release-safety": "node scripts/check-release-safety.cjs",
    "check:sync-company-settings": "node scripts/check-sync-company-settings.cjs",
    "test": "node --require ./tests/setup/register.cjs --import tsx --test --test-concurrency=1 \"tests/unit/*.test.ts\" \"tests/integration/*.test.ts\"",
    "test:online": "node --require ./tests/setup/register.cjs --import tsx --test --test-concurrency=1 \"tests/online/*.test.ts\"",
    "test:all": "npm test && npm run test:online && npm run test:ui",
    "bench:online": "node --require ./tests/setup/register.cjs --import tsx tests/bench/bridge-bench.ts docs/bench/latest.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:ui": "node --require ./tests/setup/register.cjs --import tsx --test --test-concurrency=1 \"tests/ui/*.test.ts\"",
    "snapshot:online": "tsx scripts/online-snapshot-tool.ts",
    "check:legacy": "node scripts/check-dynamic-module-access.cjs && node scripts/check-funding-transfer.cjs && node scripts/check-moisture-data-api.cjs && node scripts/check-money-out.cjs && node scripts/check-security.cjs && node scripts/check-multicompany-sync.cjs && node scripts/check-api-access.cjs",
    "bench:client": "node --require ./tests/setup/register.cjs --import tsx tests/bench/client-bench.ts docs/bench/client-latest.json",
    "bench:response": "node --require ./tests/setup/register.cjs --import tsx tests/bench/response-size.ts",
    "bench:write": "node --require ./tests/setup/register.cjs --import tsx tests/bench/write-cost.ts",
    "check:api-access": "node scripts/check-api-access.cjs"
  },
  "dependencies": {
    "better-sqlite3": "12.4.1",
    "jspdf": "3.0.2",
    "next": "15.5.27",
    "react": "19.1.7",
    "react-dom": "19.1.7",
    "xlsx": "0.18.5",
    "tailwindcss": "4.1.13",
    "@tailwindcss/postcss": "4.1.13",
    "react-icons": "^5.5.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.2",
    "@types/pg": "^8.15.5",
    "tsx": "4.23.12"
  },
  "engines": {
    "node": ">=20.11 <23"
  }
}
